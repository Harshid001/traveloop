# Traveloop Docker Environment Variables
# Copy this to .env.docker and fill in your production values

# Backend
PORT=5000
BACKEND_PORT=5000
FRONTEND_PORT=80
MONGO_URI=mongodb://mongo:27017/traveloop
MONGO_PORT=27017
REDIS_URL=redis://redis:6379
REDIS_PORT=6379
JWT_SECRET=generate_a_strong_random_64_char_secret_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost

# Sentry (optional)
SENTRY_DSN=

# API Keys
GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=gemini
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
TRIPADVISOR_API_KEY=
UNSPLASH_ACCESS_KEY=
OPENWEATHER_API_KEY=

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Traveloop <noreply@traveloop.com>