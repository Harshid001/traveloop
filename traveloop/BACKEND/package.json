{
  "name": "traveloop-backend",
  "version": "1.0.0",
  "description": "Backend API for Traveloop",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "audit:prod": "npm audit --omit=dev",
    "lint": "eslint .",
    "start:prod": "node server.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:reload": "pm2 reload ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop traveloop-api",
    "pm2:logs": "pm2 logs traveloop-api",
    "pm2:status": "pm2 status",
    "migrate:create": "migrate-mongo create",
    "migrate:up": "migrate-mongo up",
    "migrate:down": "migrate-mongo down",
    "migrate:status": "migrate-mongo status",
    "seed:world": "node src/seed/seedWorldDestinations.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@sentry/node": "^10.69.0",
    "axios": "^1.16.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "google-auth-library": "^10.7.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "morgan": "^1.10.0",
    "nodemailer": "^9.0.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.2.0",
    "migrate-mongo": "^11.0.0",
    "nodemon": "^3.1.2",
    "supertest": "^7.2.2"
  },
  "jest": {
    "setupFiles": [
      "./jest.setup.js"
    ]
  }
}
