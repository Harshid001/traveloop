# Real cities seeded from Wikidata into MongoDB (npm run seed:world)
# SEED_DESTINATION_LIMIT: max rows to fetch (default 4000; duplicates inflate this, final docs ~1700)
# SEED_MIN_POPULATION: only seed cities above this population (default 250000)
SEED_DESTINATION_LIMIT=4000
SEED_MIN_POPULATION=250000