{
  "version": 2,
  "buildCommand": "npm run build -w traveloop/FRONTEND",
  "outputDirectory": "traveloop/FRONTEND/dist",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
  