{
  "name": "traveloop",
  "private": true,
  "workspaces": [
    "traveloop/BACKEND",
    "traveloop/FRONTEND",
    "traveloop/MOBILE"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "backend": "npm run dev -w traveloop/BACKEND",
    "frontend": "npm run dev -w traveloop/FRONTEND",
    "mobile": "npm start -w traveloop/MOBILE",
    "deploy:prod": "bash scripts/deploy.sh production",
    "deploy:staging": "bash scripts/deploy.sh staging",
    "deploy:prod:ps": "powershell -File scripts/start-prod.ps1",
    "backend:pm2": "npm run pm2:start -w traveloop/BACKEND",
    "validate": "npm run lint && npm test -w traveloop/BACKEND && npm test -w traveloop/FRONTEND && npm run build -w traveloop/FRONTEND",
    "test:e2e": "npm run test:e2e -w traveloop/FRONTEND",
    "audit:all": "npm audit --workspaces --include-workspace-root --audit-level=high",
    "audit:prod": "npm audit --workspaces --include-workspace-root --omit=dev --audit-level=high"
  },
  "packageManager": "npm@10.8.2",
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "react-router": "^7.15.0",
    "uuid": "^11.1.1",
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.0.3"
  }
}